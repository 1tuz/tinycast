{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast verwendet Automation nur für Systemaktionen, die du ausdrücklich ausführst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast uses automation to perform system actions you explicitly run."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast usa la automatización para realizar las acciones del sistema que ejecutas expresamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast utilise l’automatisation pour exécuter des actions dans d’autres apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCastは、あなたが明示的に実行するシステムアクションにオートメーションを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast는 사용자가 직접 실행하는 시스템 동작을 수행할 때 자동화를 사용합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VoiceCast usa automação para realizar as ações do sistema que você executa explicitamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast использует автоматизацию для выполнения системных действий, которые вы запускаете явно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast 使用自动化来执行你主动运行的系统操作。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast greift nur auf Bluetooth zu, wenn du die Aktion „Bluetooth umschalten“ ausführst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast uses Bluetooth access only when you run the Toggle Bluetooth action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast solo accede a Bluetooth cuando ejecutas la acción de activar o desactivar Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast accède au Bluetooth uniquement lorsque vous lancez l’action d’activation ou de désactivation du Bluetooth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCastは、Bluetoothの切り替えアクションを実行したときのみBluetoothにアクセスします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast는 Bluetooth 전환 동작을 실행할 때에만 Bluetooth에 접근합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VoiceCast acessa o Bluetooth apenas quando você executa a ação de ativar ou desativar o Bluetooth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast обращается к Bluetooth только при запуске действия переключения Bluetooth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast 仅在你运行切换蓝牙操作时访问蓝牙。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast greift auf deine Termine zu, damit du deinen Zeitplan ansehen und an Besprechungen teilnehmen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast accesses your events to show your schedule and let you join meetings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast accede a tus eventos para mostrar tu agenda y permitirte unirte a reuniones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast accède à vos calendriers pour afficher votre planning, créer des événements et rejoindre vos réunions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCastはイベントにアクセスして予定を表示し、会議に参加できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast는 일정을 표시하고 회의에 참여할 수 있도록 이벤트에 접근합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VoiceCast acessa seus eventos para mostrar sua agenda e permitir que você participe de reuniões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast получает доступ к вашим событиям, чтобы показывать расписание и подключать вас к встречам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast 访问你的日程，以显示安排并让你加入会议。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast zeigt eine Kameravorschau, damit du dein Bild prüfen und ein Foto in die Zwischenablage kopieren kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast shows a camera preview so you can check yourself, and take a photo to the clipboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast muestra una vista previa de la cámara para que puedas verte y copiar una foto al portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast utilise la caméra pour afficher un aperçu vidéo et prendre des photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCastはカメラのプレビューで身だしなみを確認したり、写真を撮ってクリップボードにコピーしたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast는 자신의 모습을 확인하고 사진을 찍어 클립보드에 복사할 수 있도록 카메라 미리보기를 표시합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VoiceCast mostra uma prévia da câmera para você conferir sua imagem e tirar uma foto para a área de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast показывает изображение с камеры, чтобы вы могли проверить свой вид и скопировать снимок в буфер обмена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast 显示相机预览，方便你查看自己的形象，并将拍摄的照片拷贝到剪贴板。"
          }
        }
      }
    },

    "NSRemindersFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast erlaubt Erweiterungen, die du ausführst, deine Erinnerungen zu lesen und zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast lets extensions you run read and edit your reminders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast permite que las extensiones que ejecutas lean y editen tus recordatorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast permet aux extensions que vous lancez de lire et de modifier vos rappels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCastは、あなたが実行する拡張機能にリマインダーの読み取りと編集を許可します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast는 사용자가 실행하는 확장 프로그램이 미리 알림을 읽고 편집할 수 있게 합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VoiceCast permite que as extensões que você executa leiam e editem seus lembretes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast позволяет запускаемым вами расширениям читать и редактировать ваши напоминания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceCast 允许你运行的扩展读取和编辑你的提醒事项。"
          }
        }
      }
    },
    "VoiceCast Backup" : {
