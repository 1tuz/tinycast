{
  "name": "kube-lens",
  "title": "KubeLens",
  "description": "Read-only Kubernetes pod and event diagnostics using an explicit context.",
  "author": "tinycast",
  "version": "1.0.0",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools"
  ],
  "commands": [
    {
      "name": "index",
      "title": "KubeLens",
