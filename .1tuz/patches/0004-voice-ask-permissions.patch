diff --git a/Tinycast/Platform/MicrophoneAccess.swift b/Tinycast/Platform/MicrophoneAccess.swift
new file mode 100644
index 00000000..c128b629
--- /dev/null
+++ b/Tinycast/Platform/MicrophoneAccess.swift
@@ -0,0 +1,8 @@
+import Foundation
+
+/// TCC state for the microphone. Same three cases as camera access.
+enum MicrophoneAccess: Sendable {
+    case granted
+    case notDetermined
+    case denied
+}
