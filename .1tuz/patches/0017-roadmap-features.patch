index 00000000..83447bd3
--- /dev/null
+++ b/Tinycast/Features/Workflows/Model/WorkflowStore.swift
@@ -0,0 +1,129 @@
+import Foundation
+import Observation
+import SQLite3
+
+private let workflowSQLiteTransient = unsafeBitCast(-1, to: sqlite3_destructor_type.self)
+
+@MainActor
+@Observable
+final class WorkflowStore {
+    private(set) var workflows: [Workflow] = []
+    private(set) var isAvailable = true
+    @ObservationIgnored var onChange: (() -> Void)?
+    @ObservationIgnored private var database: OpaquePointer?
+    @ObservationIgnored private let databaseURL: URL
+    private let encoder = JSONEncoder()
+    private let decoder = JSONDecoder()
+
+    init(directory: URL) {
+        databaseURL = directory.appendingPathComponent("workflows.sqlite3")
+        do {
+            try FileManager.default.createDirectory(
+                at: directory, withIntermediateDirectories: true)
+        } catch {
+            isAvailable = false
+            return
+        }
+        guard
+            sqlite3_open_v2(
+                databaseURL.path, &database,
+                SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE, nil) == SQLITE_OK,
+            sqlite3_exec(
+                database,
+                "CREATE TABLE IF NOT EXISTS workflows(id TEXT PRIMARY KEY, definition TEXT NOT NULL)",
+                nil, nil, nil) == SQLITE_OK
+        else {
+            sqlite3_close_v2(database)
+            database = nil
+            isAvailable = false
+            return
+        }
+        load()
+    }
+
+    isolated deinit { sqlite3_close_v2(database) }
+
+    func load() {
+        guard let database else { return }
+        var statement: OpaquePointer?
+        guard
+            sqlite3_prepare_v2(
+                database, "SELECT definition FROM workflows ORDER BY rowid", -1,
+                &statement, nil) == SQLITE_OK, let statement
+        else { return }
+        defer { sqlite3_finalize(statement) }
+        var loaded: [Workflow] = []
+        while sqlite3_step(statement) == SQLITE_ROW {
+            guard let value = Self.columnString(statement, 0),
+                let workflow = try? decoder.decode(
+                    Workflow.self, from: Data(value.utf8))
+            else { continue }
+            loaded.append(workflow)
+        }
+        workflows = loaded
+    }
+
+    @discardableResult
+    func create() -> UUID? {
+        let workflow = Workflow()
+        guard save(workflow) else { return nil }
+        workflows.append(workflow)
+        onChange?()
+        return workflow.id
+    }
+
+    func update(_ workflow: Workflow) {
+        guard let index = workflows.firstIndex(where: { $0.id == workflow.id }) else { return }
+        let previous = workflows[index]
+        guard save(workflow) else { return }
+        workflows[index] = workflow
+        if previous.isEnabled != workflow.isEnabled
+            || previous.trigger != workflow.trigger
+            || previous.commandID != workflow.commandID
+        {
+            onChange?()
+        }
+    }
+
+    func delete(id: UUID) {
+        guard let database else { return }
+        var statement: OpaquePointer?
+        guard
+            sqlite3_prepare_v2(
+                database, "DELETE FROM workflows WHERE id = ?1", -1,
+                &statement, nil) == SQLITE_OK, let statement
+        else { return }
+        defer { sqlite3_finalize(statement) }
+        sqlite3_bind_text(statement, 1, id.uuidString, -1, workflowSQLiteTransient)
+        guard sqlite3_step(statement) == SQLITE_DONE else { return }
+        workflows.removeAll { $0.id == id }
+        onChange?()
+    }
+
+    func workflow(id: UUID) -> Workflow? { workflows.first { $0.id == id } }
+
+    private func save(_ workflow: Workflow) -> Bool {
+        guard let database, let data = try? encoder.encode(workflow),
+            let definition = String(data: data, encoding: .utf8)
+        else { return false }
+        var statement: OpaquePointer?
+        guard
+            sqlite3_prepare_v2(
+                database,
+                "INSERT OR REPLACE INTO workflows(id, definition) VALUES(?1, ?2)",
+                -1, &statement, nil) == SQLITE_OK, let statement
+        else { return false }
+        defer { sqlite3_finalize(statement) }
+        sqlite3_bind_text(
+            statement, 1, workflow.id.uuidString, -1, workflowSQLiteTransient)
+        sqlite3_bind_text(statement, 2, definition, -1, workflowSQLiteTransient)
+        return sqlite3_step(statement) == SQLITE_DONE
+    }
+
+    nonisolated private static func columnString(
+        _ statement: OpaquePointer?, _ index: Int32
+    ) -> String? {
+        guard let pointer = sqlite3_column_text(statement, index) else { return nil }
+        return String(cString: pointer)
+    }
+}
diff --git a/Tinycast/Features/Workflows/Service/WorkflowCoordinator.swift b/Tinycast/Features/Workflows/Service/WorkflowCoordinator.swift
new file mode 100644
index 00000000..ca89b36b
--- /dev/null
+++ b/Tinycast/Features/Workflows/Service/WorkflowCoordinator.swift
@@ -0,0 +1,151 @@
+import AppKit
+import Darwin
+import Dispatch
+import Observation
+
+@MainActor
+@Observable
+final class WorkflowCoordinator {
+    let store: WorkflowStore
+    private let settings: AppSettings
+    private let hotKeys: HotKeyManager
+    var onRunCommand: ((CommandID) -> Void)?
+
+    @ObservationIgnored private var timeTimer: Timer?
+    @ObservationIgnored private var clipboardTimer: Timer?
+    @ObservationIgnored private var clipboardChangeCount: Int?
+    @ObservationIgnored private var fileWatchers: [UUID: DispatchSourceFileSystemObject] = [:]
+    @ObservationIgnored private var lastTimeMinute: [UUID: Int] = [:]
+    @ObservationIgnored private var lastFileEvent: [UUID: Date] = [:]
+    private(set) var unavailableFolderIDs: Set<UUID> = []
+
+    init(store: WorkflowStore, settings: AppSettings, hotKeys: HotKeyManager) {
+        self.store = store
+        self.settings = settings
+        self.hotKeys = hotKeys
+    }
+
+    isolated deinit { stopMonitors() }
+
+    func start() {
+        store.onChange = { [weak self] in self?.refresh() }
+        refresh()
+    }
+
+    func allows(_ id: UUID) -> Bool {
+        settings.workflowsEnabled && store.workflow(id: id)?.isEnabled == true
+    }
+
+    func run(_ id: UUID) {
+        guard allows(id), let workflow = store.workflow(id: id),
+            let command = workflow.command
+        else { return }
+        onRunCommand?(command)
+    }
+
+    func applyEnabled() { applyTriggers() }
+
+    private func refresh() {
+        hotKeys.updateWorkflows(Set(store.workflows.map(\.id)))
+        applyTriggers()
+    }
+
+    private func applyTriggers() {
+        stopMonitors()
+        guard settings.workflowsEnabled else { return }
+        let enabled = store.workflows.filter(\.isEnabled)
+        if enabled.contains(where: { $0.trigger.kind == .dailyTime }) {
+            let timer = Timer(timeInterval: 15, repeats: true) { [weak self] _ in
+                MainActor.assumeIsolated { self?.checkTimeTriggers() }
+            }
+            RunLoop.main.add(timer, forMode: .common)
+            timeTimer = timer
+        }
+        if enabled.contains(where: { $0.trigger.kind == .clipboardChange }) {
+            clipboardChangeCount = NSPasteboard.general.changeCount
+            let timer = Timer(timeInterval: 0.5, repeats: true) { [weak self] _ in
+                MainActor.assumeIsolated { self?.checkClipboardTrigger() }
+            }
+            timer.tolerance = 0.1
+            RunLoop.main.add(timer, forMode: .common)
+            clipboardTimer = timer
+        }
+        for workflow in enabled where workflow.trigger.kind == .fileChange {
+            watch(workflow)
+        }
+    }
+
+    private func stopMonitors() {
+        timeTimer?.invalidate()
+        timeTimer = nil
+        clipboardTimer?.invalidate()
+        clipboardTimer = nil
+        clipboardChangeCount = nil
+        for watcher in fileWatchers.values { watcher.cancel() }
+        fileWatchers.removeAll()
+        unavailableFolderIDs.removeAll()
+    }
+
+    private func checkTimeTriggers(now: Date = Date()) {
+        guard settings.workflowsEnabled else { return }
+        let calendar = Calendar.current
+        let hour = calendar.component(.hour, from: now)
+        let minute = calendar.component(.minute, from: now)
+        let minuteStamp = Int(now.timeIntervalSince1970 / 60)
+        for workflow in store.workflows where workflow.isEnabled {
+            guard workflow.trigger.kind == .dailyTime,
+                workflow.trigger.hour == hour, workflow.trigger.minute == minute,
+                lastTimeMinute[workflow.id] != minuteStamp
+            else { continue }
+            lastTimeMinute[workflow.id] = minuteStamp
+            run(workflow.id)
+        }
+    }
+
+    private func checkClipboardTrigger() {
+        let pasteboard = NSPasteboard.general
+        guard pasteboard.changeCount != clipboardChangeCount else { return }
+        clipboardChangeCount = pasteboard.changeCount
+        guard pasteboard.types?.contains(ClipboardManager.internalType) != true else { return }
+        for workflow in store.workflows
+        where workflow.isEnabled && workflow.trigger.kind == .clipboardChange {
+            run(workflow.id)
+        }
+    }
+
+    private func watch(_ workflow: Workflow) {
+        let id = workflow.id
+        let path = workflow.trigger.path.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !path.isEmpty, fileWatchers[id] == nil else { return }
+        let descriptor = open(path, O_EVTONLY)
+        guard descriptor >= 0 else {
+            unavailableFolderIDs.insert(id)
+            return
+        }
+        unavailableFolderIDs.remove(id)
+        let events: DispatchSource.FileSystemEvent = [.write, .extend, .attrib, .rename, .delete]
+        let source = DispatchSource.makeFileSystemObjectSource(
+            fileDescriptor: descriptor, eventMask: events, queue: .main)
+        source.setEventHandler { [weak self] in
+            MainActor.assumeIsolated {
+                guard let self, let event = self.fileWatchers[id]?.data else { return }
+                let removed = event.contains(.rename) || event.contains(.delete)
+                self.handleFileEvent(id, removed: removed)
+            }
+        }
+        source.setCancelHandler { close(descriptor) }
+        fileWatchers[id] = source
+        source.resume()
+    }
+
+    private func handleFileEvent(_ id: UUID, removed: Bool) {
+        if removed {
+            fileWatchers.removeValue(forKey: id)?.cancel()
+            unavailableFolderIDs.insert(id)
+        }
+        let now = Date()
+        guard now.timeIntervalSince(lastFileEvent[id] ?? .distantPast) >= 0.5 else { return }
+        lastFileEvent[id] = now
+        run(id)
+    }
+}
diff --git a/Tinycast/Features/Workflows/UI/WorkflowSettingsSection.swift b/Tinycast/Features/Workflows/UI/WorkflowSettingsSection.swift
new file mode 100644
index 00000000..acf8e2c0
--- /dev/null
+++ b/Tinycast/Features/Workflows/UI/WorkflowSettingsSection.swift
@@ -0,0 +1,162 @@
+import AppKit
+import SwiftUI
+
+struct WorkflowSettingsSection: View {
+    @Environment(AppCore.self) private var core
+    @Environment(AppSettings.self) private var settings
+
+    var body: some View {
+        @Bindable var settings = settings
+        Section {
+            Toggle(isOn: $settings.workflowsEnabled) {
+                SettingsRowTitle(.generalWorkflows, "Enable workflows")
+                Text("Run local commands on a daily schedule, hotkey, clipboard or folder change.")
+            }
+            if settings.workflowsEnabled {
+                if !core.workflows.isAvailable {
+                    Text("Local workflow storage could not be opened.")
+                        .foregroundStyle(.secondary)
+                } else {
+                    ForEach(core.workflows.workflows) { workflow in
+                        WorkflowSettingsRow(
+                            workflow: workflow,
+                            availableCommands: availableCommands,
+                            isFolderUnavailable: core.workflowCoordinator.unavailableFolderIDs.contains(
+                                workflow.id),
+                            update: core.workflows.update,
+                            delete: { core.workflows.delete(id: workflow.id) })
+                    }
+                    Button("Add Workflow", systemImage: "plus") {
+                        _ = core.workflows.create()
+                    }
+                }
+            }
+        } header: {
+            SettingsSectionHeader(.generalWorkflows)
+        } footer: {
+            Text("Runs only while Tinycast is open. Workflow definitions stay on this Mac.")
+                .font(.caption)
+                .foregroundStyle(.secondary)
+        }
+    }
+
+    private var availableCommands: [CommandID] {
+        Workflow.availableCommands.filter(core.appIndex.isCommandEnabled)
+    }
+}
+
+private struct WorkflowSettingsRow: View {
+    let workflow: Workflow
+    let availableCommands: [CommandID]
+    let isFolderUnavailable: Bool
+    let update: (Workflow) -> Void
+    let delete: () -> Void
+
+    var body: some View {
+        DisclosureGroup {
+            TextField("Workflow name", text: value(\.name))
+            Toggle("Enabled", isOn: value(\.isEnabled))
+            Picker("Trigger", selection: value(\.trigger.kind)) {
+                ForEach(WorkflowTriggerKind.allCases) { kind in
+                    Text(kind.title).tag(kind)
+                }
+            }
+            triggerSettings
+            Picker("Run command", selection: value(\.commandID)) {
+                ForEach(availableCommands, id: \.rawValue) { command in
+                    Text(command.name).tag(command.rawValue)
+                }
+                if !availableCommands.contains(where: { $0.rawValue == workflow.commandID }) {
+                    Text(
+                        CommandID(rawValue: workflow.commandID).map {
+                            "\($0.name) (Unavailable)"
+                        } ?? "Unavailable command"
+                    )
+                    .tag(workflow.commandID)
+                    .disabled(true)
+                }
+            }
+            HStack {
+                Spacer()
+                Button("Delete Workflow", role: .destructive, action: delete)
+            }
+        } label: {
+            Label(
+                workflow.name.isEmpty ? "Unnamed Workflow" : workflow.name,
+                systemImage: "arrow.trianglehead.2.clockwise"
+            )
+            .lineLimit(1)
+        }
+        .padding(.vertical, Theme.Spacing.xs)
+    }
+
+    @ViewBuilder
+    private var triggerSettings: some View {
+        switch workflow.trigger.kind {
+        case .dailyTime:
+            DatePicker("Run daily at", selection: scheduledTime, displayedComponents: .hourAndMinute)
+        case .hotkey:
+            LabeledContent("Shortcut") {
+                ShortcutRecorder(action: .workflow(id: workflow.id), isQuiet: true)
+            }
+        case .clipboardChange:
+            Text("The clipboard content is not read or stored for this trigger.")
+                .font(.caption)
+                .foregroundStyle(.secondary)
+        case .fileChange:
+            HStack {
+                Text(workflow.trigger.path.isEmpty ? "Choose a folder" : workflow.trigger.path)
+                    .lineLimit(1)
+                    .truncationMode(.middle)
+                    .foregroundStyle(.secondary)
+                Spacer()
+                Button("Choose…", action: choosePath)
+            }
+            Text("Runs when the selected folder changes.")
+                .font(.caption)
+                .foregroundStyle(.secondary)
+            if isFolderUnavailable {
+                Text("This folder is unavailable. Choose it again.")
+                    .font(.caption)
+                    .foregroundStyle(.red)
+            }
+        }
+    }
+
+    private var scheduledTime: Binding<Date> {
+        Binding(
+            get: {
+                Calendar.current.date(
+                    from: DateComponents(hour: workflow.trigger.hour, minute: workflow.trigger.minute))
+                    ?? Date()
+            },
+            set: { date in
+                var updated = workflow
+                updated.trigger.hour = Calendar.current.component(.hour, from: date)
+                updated.trigger.minute = Calendar.current.component(.minute, from: date)
+                update(updated)
+            })
+    }
+
+    private func value<Value>(_ keyPath: WritableKeyPath<Workflow, Value>) -> Binding<Value> {
+        Binding(
+            get: { workflow[keyPath: keyPath] },
+            set: { value in
+                var updated = workflow
+                updated[keyPath: keyPath] = value
+                update(updated)
+            })
+    }
+
+    private func choosePath() {
+        let panel = NSOpenPanel()
+        panel.title = "Choose a folder to watch"
+        panel.canChooseFiles = false
+        panel.canChooseDirectories = true
+        panel.allowsMultipleSelection = false
+        guard panel.runModal() == .OK, let url = panel.url else { return }
+        var updated = workflow
+        updated.trigger.path = url.path
+        update(updated)
+    }
+}
