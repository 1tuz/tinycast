+/// Fixed string rules keep tags local and only use OCR stored by clipboard text-search opt-in.
+private enum ClipboardVisualTag: String, Identifiable {
+    case receipt
+    case code
+    case design
+
+    var id: String { rawValue }
+    var title: String { rawValue.capitalized }
+
+    static func classify(_ recognizedText: String) -> [Self] {
+        let text = recognizedText.lowercased()
+        guard !text.isEmpty else { return [] }
+
+        var tags: [Self] = []
+        let receiptSignals = [
+            "receipt", "invoice", "subtotal", "amount due", "balance due", "change due",
+            "cashier", "order total"
+        ]
+        let paymentSignals = ["tax", "payment", "total"]
+        let receiptMatches = receiptSignals.filter { text.contains($0) }.count
+        let paymentMatches = paymentSignals.filter { text.contains($0) }.count
+        let hasCurrency = ["$", "€", "£", "¥", "usd", "eur", "gbp"].contains { text.contains($0) }
+        if receiptMatches > 0 || (hasCurrency && paymentMatches >= 2) {
+            tags.append(.receipt)
+        }
+
+        let codeSignals = [
+            "func ", "let ", "const ", "var ", "return ", "import ", "class ", "struct ",
+            "enum ", "def ", "select ", "from ", "where ", "=>", "->"
+        ]
+        if codeSignals.filter({ text.contains($0) }).count >= 2 {
+            tags.append(.code)
+        }
+
+        let designSignals = [
+            "figma", "sketch", "artboard", "typography", "font", "padding", "margin",
+            "opacity", "layer", "hex", "rgba", "rgb(", "px"
+        ]
+        let designMatches = designSignals.filter { text.contains($0) }.count
+        if designMatches >= 2 || (designMatches > 0 && text.contains("#")) {
+            tags.append(.design)
+        }
+        return tags
+    }
 }
 
