+            content.glassEffect(.regular, in: RoundedRectangle(cornerRadius: Theme.Radius.dialog))
+        } else {
+            content.background(
+                .regularMaterial, in: RoundedRectangle(cornerRadius: Theme.Radius.dialog))
+        }
+    }
+}
